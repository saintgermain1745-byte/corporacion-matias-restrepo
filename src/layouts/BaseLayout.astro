---
import { officialOfficeAddress } from '../data/contact';

export interface Props {
  title: string;
}

const { title } = Astro.props;
const currentPath = Astro.url.pathname;

// --- LÓGICA DEL MENÚ INTELIGENTE ---
const isEn = currentPath.startsWith('/en');
const footerAddress = isEn ? officialOfficeAddress.en : officialOfficeAddress.es;
const routes = {
  home: isEn ? '/en/' : '/',
  projects: isEn ? '/en/projects' : '/proyectos',
  news: isEn ? '/en/news' : '/noticias',
  about: isEn ? '/en/about' : '/nosotros',
  gallery: isEn ? '/en/gallery' : '/galeria',
  contact: isEn ? '/en/contact' : '/contacto',
  volunteer: isEn ? '/en/volunteer' : '/voluntariado',
  donate: isEn ? '/en/donate' : '/donar',
  transparency: isEn ? '/en/transparency' : '/transparencia',
  privacy: isEn ? '/en/privacy' : '/privacidad'
};
const isActive = (path: string) => {
  if (path === '/' || path === '/en/') return currentPath === path;
  return currentPath.startsWith(path);
};
const campaignHref = currentPath === routes.home
  ? '#campana-navidad'
  : `${routes.home}#campana-navidad`;

const alternateRoutes: Record<string, string> = {
  '/': '/en/',
  '/en/': '/',
  '/proyectos': '/en/projects',
  '/en/projects': '/proyectos',
  '/noticias': '/en/news',
  '/en/news': '/noticias',
  '/nosotros': '/en/about',
  '/en/about': '/nosotros',
  '/galeria': '/en/gallery',
  '/en/gallery': '/galeria',
  '/contacto': '/en/contact',
  '/en/contact': '/contacto',
  '/voluntariado': '/en/volunteer',
  '/en/volunteer': '/voluntariado',
  '/donar': '/en/donate',
  '/en/donate': '/donar',
  '/transparencia': '/en/transparency',
  '/en/transparency': '/transparencia',
  '/privacidad': '/en/privacy',
  '/en/privacy': '/privacidad'
};

const normalizedPath = currentPath.replace(/\/$/, '') || '/';
const englishPath = alternateRoutes[normalizedPath]?.startsWith('/en/')
  ? alternateRoutes[normalizedPath]
  : alternateRoutes[normalizedPath] || '/en/';
const spanishPath = alternateRoutes[normalizedPath]?.startsWith('/en/')
  ? normalizedPath
  : alternateRoutes[normalizedPath] || '/';
---

<!doctype html>
<html lang={isEn ? "en" : "es"}>
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content="Corporación Matías Restrepo - Excelencia con sentido humano. Apoyamos a personas con discapacidad y cáncer en Guarne, Antioquia." />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/png" href="/logo.png" />
    
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;600&family=Playfair+Display:ital,wght@0,600;1,600&display=swap" rel="stylesheet">
    <link href="https://unpkg.com/aos@2.3.1/dist/aos.css" rel="stylesheet">
    
    <title>{title} | Corporación Matías Restrepo</title>
    
    <style is:global>
      /* BLINDAJE CONTRA DESBORDAMIENTO HORIZONTAL */
      html, body { overflow-x: hidden; max-width: 100vw; margin: 0; padding: 0; }
      *, *::before, *::after { box-sizing: border-box; }
      
      :root {
        --color-primario: #c1121f;
        --color-secundario: #2a9d8f;
        --color-texto: #2b2b2b;
        --color-fondo: #ffffff;
        --campaign-announcement-height: 38px;
        --fuente-titulos: 'Playfair Display', serif;
        --fuente-cuerpo: 'Inter', sans-serif;
      }
      
      body { font-family: var(--fuente-cuerpo); color: var(--color-texto); background-color: var(--color-fondo); line-height: 1.6; -webkit-font-smoothing: antialiased; }
      h1, h2, h3 { font-family: var(--fuente-titulos); font-weight: 600; color: #1a1a1a; }
      a { text-decoration: none; color: inherit; }

      .campaign-announcement {
        position: fixed;
        z-index: 10001;
        top: 0;
        left: 0;
        display: flex;
        width: 100%;
        height: var(--campaign-announcement-height);
        align-items: center;
        justify-content: center;
        padding: 0 3rem;
        background: linear-gradient(100deg, #b91c1c, #15803d);
        color: #fff;
        text-align: center;
      }
      .campaign-announcement[hidden] { display: none; }
      .campaign-announcement-link { color: #fff; font-size: 0.82rem; font-weight: 600; line-height: 1.25; }
      .campaign-announcement-link:hover { text-decoration: underline; text-underline-offset: 3px; }
      .campaign-announcement-close {
        position: absolute;
        top: 50%;
        right: 0.55rem;
        display: grid;
        width: 28px;
        height: 28px;
        place-items: center;
        transform: translateY(-50%);
        border: 0;
        border-radius: 50%;
        background: rgba(255, 255, 255, 0.15);
        color: #fff;
        font-size: 1.15rem;
        line-height: 1;
        cursor: pointer;
      }
      .campaign-announcement-close:hover { background: rgba(255, 255, 255, 0.28); }
      
      /* --- HEADER FIJO Y BLINDADO (SIN SALTOS) --- */
      .main-header {
        position: fixed; /* Fijo en la parte superior */
        top: var(--campaign-announcement-height);
        left: 0;
        width: 100%;
        z-index: 9999;
        display: flex; justify-content: space-between; align-items: center;
        background: rgba(255, 255, 255, 0.98); backdrop-filter: blur(10px);
        padding: 1rem 5%; /* Padding constante, nunca cambia */
        border-bottom: 1px solid #eaeaea;
        box-shadow: 0 4px 15px rgba(0, 0, 0, 0.05);
        gap: 1rem;
      }
      
      /* Como el header es fixed, empujamos el contenido hacia abajo para que no quede oculto */
      main {
        padding-top: calc(110px + var(--campaign-announcement-height));
      }
      @media (max-width: 1024px) {
        main { padding-top: calc(90px + var(--campaign-announcement-height)); } /* Menos espacio en móvil */
      }
      @media (max-width: 760px) {
        :root { --campaign-announcement-height: 58px; }
        .campaign-announcement { padding: 0 2.6rem 0 0.6rem; }
        .campaign-announcement-link { font-size: 0.72rem; }
      }
      
      /* BLINDAJE DEL LOGO */
      .header-top { display: flex; align-items: center; flex-shrink: 0; }
      .header-logo { display: flex; align-items: center; text-decoration: none; flex-shrink: 0; }
      
      .main-header .logo-img { 
        width: 60px !important; 
        max-width: 60px !important;
        height: auto !important;
      }
      
      .main-header .logo-text {
        font-family: var(--fuente-titulos);
        font-size: 1.3rem;
        font-weight: 600;
        color: #1a1a1a;
        margin-left: 10px;
        white-space: nowrap;
      }

      .logo-text-en { font-size: 1.1rem !important; }
      
      /* --- MENÚ DE ENLACES --- */
      .desktop-nav { display: flex; gap: 0.2rem; align-items: center; justify-content: center; flex-grow: 1; margin: 0 1rem; }
      .nav-link { display: flex; align-items: center; gap: 8px; padding: 0.5rem 0.7rem; border-radius: 5px; transition: all 0.3s ease; font-size: 0.95rem; white-space: nowrap; }
      .nav-link svg { width: 22px; height: 22px; }
      .nav-link:hover { color: var(--color-primario); background-color: #f0f0f0; }
      .nav-link.active { font-weight: 600; color: var(--color-primario); border-bottom: 2px solid var(--color-primario); border-radius: 0; }
      
      /* --- ACCIONES DERECHA --- */
      .header-actions { display: flex; align-items: center; gap: 1rem; flex-shrink: 0; }
      .lang-selector { display: flex; align-items: center; gap: 4px; font-weight: 600; font-size: 0.9rem; }
      .btn-donar { display: flex; align-items: center; gap: 6px; background: var(--color-primario); color: white; padding: 0.6rem 1.5rem; border-radius: 50px; font-weight: 600; transition: transform 0.2s; white-space: nowrap; }
      
      /* --- MENÚ MÓVIL --- */
      .hamburger { display: none; width: 44px; height: 44px; align-items: center; justify-content: center; padding: 0; border: 0; background: none; color: #1a1a1a; cursor: pointer; }
      .hamburger svg { display: block; width: 32px; height: 32px; overflow: visible; }
      .hamburger path { fill: none; stroke-width: 2.4; stroke-linecap: round; stroke-linejoin: round; }
      .mobile-nav { display: none; flex-direction: column; width: 100%; max-height: calc(100dvh - var(--campaign-announcement-height) - 90px); overflow-y: auto; overscroll-behavior: contain; background: white; border-top: 1px solid #eaeaea; position: absolute; top: 100%; left: 0; z-index: 99; box-shadow: 0 10px 15px rgba(0,0,0,0.05); }
      .mobile-nav.active { display: flex; }
      .mobile-nav .nav-link { min-height: 46px; padding: 0.72rem 1rem; border-bottom: 1px solid #f0f0f0; border-radius: 0; font-size: 1rem; }
      body.mobile-menu-open #accessibility-btn,
      body.mobile-menu-open #accessibility-panel { display: none !important; }
      body.mobile-menu-open .floatingchat-container-wrap,
      body.mobile-menu-open .floatingchat-container-wrap-mobi,
      body.mobile-menu-open .floatingchat-container,
      body.mobile-menu-open .floatingchat-container-mobi { display: none !important; }
      
      @media (max-width: 1024px) {
        .main-header { flex-direction: column; align-items: flex-start; padding: 1rem 5%; position: fixed; }
        .header-top { width: 100%; min-width: 0; display: flex; justify-content: space-between; align-items: center; }
        .header-logo { min-width: 0; }
        .desktop-nav, .header-actions { display: none; }
        .hamburger { display: flex; }
        .main-header .logo-text { font-size: 1.1rem; }
        .logo-text-en { font-size: 1rem !important; }
        .main-header .logo-img { width: 50px !important; max-width: 50px !important; }
        .floatingchat-container-wrap, .floatingchat-container-wrap-mobi { transform: scale(0.85); transform-origin: bottom left; }
      }

      @media (max-width: 600px) {
        .main-header { padding: 0.75rem 5%; }
        .header-top { gap: 0.6rem; }
        .header-logo { max-width: calc(100% - 3.25rem); }
        .main-header .logo-img { width: 44px !important; max-width: 44px !important; }
        .main-header .logo-text { min-width: 0; margin-left: 0.5rem; font-size: clamp(0.8rem, 3.7vw, 0.95rem); line-height: 1.15; white-space: normal; }
        .main-header .logo-text-en { font-size: clamp(0.78rem, 3.4vw, 0.9rem) !important; }
        .hamburger { flex: 0 0 42px; width: 42px; height: 42px; }
      }

      /* --- ACCESIBILIDAD --- */
      body.high-contrast { background-color: #000 !important; color: #fff !important; }
      body.high-contrast main, body.high-contrast footer, body.high-contrast header, body.high-contrast section, body.high-contrast div, body.high-contrast h1, body.high-contrast h2, body.high-contrast h3, body.high-contrast p, body.high-contrast a, body.high-contrast span, body.high-contrast li { background-color: #000 !important; color: #ffeb3b !important; }
      body.high-contrast img { filter: grayscale(100%) contrast(120%); }
      body.high-contrast button, body.high-contrast a[style*="background"] { background-color: #ffeb3b !important; color: #000 !important; border: 2px solid #fff !important; }
      #accessibility-panel h3 { font-family: var(--fuente-cuerpo) !important; font-size: 1rem !important; font-weight: 600 !important; margin-bottom: 1rem !important; color: #1a1a1a !important; }
      .footer-bottom { margin-top: 1.5rem; border-top: 1px solid #333; padding-top: 1.25rem; width: 100%; font-size: 0.8rem; color: #666; display: flex; align-items: center; justify-content: space-between; gap: 1rem; text-align: left; }
      .footer-copyright { display: flex; flex-direction: column; gap: 0.35rem; }
      .footer-powered { display: flex; align-items: center; gap: 0.6rem; color: #a0a0a0; white-space: nowrap; }
      .footer-powered img { display: block; height: 35px; width: auto; filter: brightness(2.1); transition: transform 0.2s ease; }
      .footer-powered:hover img { transform: scale(1.05); }
      .footer-address { max-width: 580px; color: #a0a0a0; font-size: 0.85rem; font-style: normal; line-height: 1.55; }
      .footer-address strong { display: block; margin-bottom: 0.25rem; color: #dedede; }
      .allies-grid { position: relative; display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); align-items: center; gap: clamp(0.35rem, 2vw, 1.25rem); max-width: 1000px; margin: 0 auto; padding: 14px 12px; }
      .ally-logo { position: relative; z-index: 1; display: flex; width: 100%; height: 82px; align-items: center; justify-content: center; border: 1px solid rgba(43, 43, 43, 0.045); border-radius: 17px; background: rgba(255, 255, 255, 0.72); box-shadow: 0 5px 18px rgba(43, 43, 43, 0.035); }
      .ally-logo img { display: block; max-width: calc(100% - 1rem); max-height: 58px; width: auto; height: auto; object-fit: contain; filter: grayscale(100%); opacity: 0.62; transition: filter 0.35s ease, opacity 0.35s ease, transform 0.35s ease; }
      .ally-logo:hover img, .ally-logo.is-active img { filter: grayscale(0%); opacity: 1; }
      .ally-logo:focus-visible { outline: 2px solid var(--color-primario); outline-offset: 3px; border-radius: 17px; }
      .allies-flow { position: absolute; z-index: 2; inset: 0; width: 100%; height: 100%; overflow: visible; pointer-events: none; }
      .allies-flow-path { fill: none; stroke: url(#allies-flow-gradient); stroke-width: 1.6; stroke-linecap: round; stroke-linejoin: round; opacity: 0.8; filter: drop-shadow(0 0 3px rgba(22, 163, 74, 0.25)); }
      .allies-flow-pulse { fill: #dc2626; stroke: white; stroke-width: 2; filter: drop-shadow(0 1px 5px rgba(220, 38, 38, 0.4)); }
      @media (prefers-reduced-motion: reduce) {
        .ally-logo img { transition: none; }
      }
      @media (max-width: 600px) {
        .footer-bottom { flex-direction: column; text-align: center; }
        .footer-powered { justify-content: center; }
      }
      @media (max-width: 700px) {
        .allies-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 1rem; }
        .allies-grid > * { justify-self: center; }
        .ally-logo { width: min(150px, 100%); }
      }
    </style>
  </head>
  
  <body>
    <div class="campaign-announcement" data-campaign-announcement>
      <a class="campaign-announcement-link" href={campaignHref}>
        {isEn
          ? '🎄 Christmas Toy & Gift Drive: Accepting donations until Dec 18 · Join now →'
          : '🎄 Recolección Navideña: Recibimos regalos hasta el 18 de diciembre · Súmate aquí →'}
      </a>
      <button
        class="campaign-announcement-close"
        type="button"
        data-campaign-announcement-close
        aria-label={isEn ? 'Hide campaign announcement' : 'Ocultar anuncio de campaña'}
      >×</button>
    </div>

    <header class="main-header">
      
      <!-- LOGO -->
      <div class="header-top">
        <a href={routes.home} class="header-logo">
          <img src="/logo.png" alt="Logo" class="logo-img" />
          <span class={`logo-text ${isEn ? 'logo-text-en' : ''}`}>
            {isEn ? (
              <>Matías Restrepo <span style="color: var(--color-primario);">Corporation</span></>
            ) : (
              <>Corporación <span style="color: var(--color-primario);">Matías Restrepo</span></>
            )}
          </span>
        </a>
        <button
          class="hamburger"
          id="mobile-menu-btn"
          type="button"
          aria-label={isEn ? 'Open menu' : 'Abrir menú'}
          aria-expanded="false"
          aria-controls="mobile-menu"
          data-open-label={isEn ? 'Open menu' : 'Abrir menú'}
          data-close-label={isEn ? 'Close menu' : 'Cerrar menú'}
        >
          <svg viewBox="0 0 32 32" aria-hidden="true" focusable="false">
            <path data-menu-stroke="left-upper" stroke="#1a1a1a" d="M4 8 C7 8 11 8 15 8 C19 8 23 8 28 8 C28 8 28 8 28 8" />
            <path data-menu-stroke="right" stroke="#1a1a1a" d="M4 16 C7 16 11 16 15 16 C19 16 23 16 28 16 C28 16 28 16 28 16" />
            <path data-menu-stroke="left-lower" stroke="#1a1a1a" d="M4 24 C7 24 11 24 15 24 C19 24 23 24 28 24 C28 24 28 24 28 24" />
          </svg>
        </button>
      </div>
      
      <!-- MENÚ PC -->
      <nav class="desktop-nav">
        <a href={routes.home} class:list={["nav-link", { active: isActive(routes.home) }]} aria-current={isActive(routes.home) ? 'page' : undefined}>
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m3 9 9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"></path><polyline points="9 22 9 12 15 12 15 22"></polyline></svg>
          {isEn ? 'Home' : 'Inicio'}
        </a>
        <a href={routes.projects} class:list={["nav-link", { active: isActive(routes.projects) }]} aria-current={isActive(routes.projects) ? 'page' : undefined}>
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="7" width="20" height="14" rx="2" ry="2"></rect><path d="M16 21V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16"></path></svg>
          {isEn ? 'Projects' : 'Proyectos'}
        </a>
        <a href={routes.news} class:list={["nav-link", { active: isActive(routes.news) }]} aria-current={isActive(routes.news) ? 'page' : undefined}>
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 22h16a2 2 0 0 0 2-2V4a2 2 0 0 0-2-2H8a2 2 0 0 0-2 2v16a2 2 0 0 1-2 2Zm0 0a2 2 0 0 1-2-2v-9c0-1.1.9-2 2-2h2"></path><path d="M18 14h-8"></path><path d="M15 18h-5"></path><path d="M10 6h8v4h-8V6Z"></path></svg>
          {isEn ? 'News' : 'Noticias'}
        </a>
        <a href={routes.about} class:list={["nav-link", { active: isActive(routes.about) }]} aria-current={isActive(routes.about) ? 'page' : undefined}>
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path><circle cx="9" cy="7" r="4"></circle><path d="M23 21v-2a4 4 0 0 0-3-3.87"></path><path d="M16 3.13a4 4 0 0 1 0 7.75"></path></svg>
          {isEn ? 'About Us' : 'Nosotros'}
        </a>
        <a href={routes.gallery} class:list={["nav-link", { active: isActive(routes.gallery) }]} aria-current={isActive(routes.gallery) ? 'page' : undefined}>
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="18" height="18" rx="2" ry="2"></rect><circle cx="8.5" cy="8.5" r="1.5"></circle><polyline points="21 15 16 10 5 21"></polyline></svg>
          {isEn ? 'Gallery' : 'Galería'}
        </a>
        <a href={routes.contact} class:list={["nav-link", { active: isActive(routes.contact) }]} aria-current={isActive(routes.contact) ? 'page' : undefined}>
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path><polyline points="22,6 12,13 2,6"></polyline></svg>
          {isEn ? 'Contact' : 'Contacto'}
        </a>
        <a href={routes.volunteer} class:list={["nav-link", { active: isActive(routes.volunteer) }]} aria-current={isActive(routes.volunteer) ? 'page' : undefined}>
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20.42 4.58a5.4 5.4 0 0 0-7.65 0l-.77.78-.77-.78a5.4 5.4 0 0 0-7.65 0C1.46 6.7 1.33 10.28 4 13l8 8 8-8c2.67-2.72 2.54-6.3.42-8.42z"></path></svg>
          {isEn ? 'Volunteer' : 'Voluntariado'}
        </a>
      </nav>

      <!-- ACCIONES DERECHA -->
      <div class="header-actions">
        <div class="lang-selector">
          <a href={isEn ? spanishPath : normalizedPath} style="color: #1a1a1a;">ES</a>
          <span style="color: #ccc;">|</span>
          <a href={isEn ? normalizedPath : englishPath} style="color: #888;">EN</a>
        </div>
        <a href={routes.donate} class="btn-donar">
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="width:20px; height:20px;"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"></path></svg>
          {isEn ? 'Donate' : 'Donar'}
        </a>
      </div>

      <!-- MENÚ MÓVIL -->
      <nav class="mobile-nav" id="mobile-menu" aria-hidden="true">
        <a href={routes.home} class:list={["nav-link", { active: isActive(routes.home) }]} aria-current={isActive(routes.home) ? 'page' : undefined}>{isEn ? 'Home' : 'Inicio'}</a>
        <a href={routes.projects} class:list={["nav-link", { active: isActive(routes.projects) }]} aria-current={isActive(routes.projects) ? 'page' : undefined}>{isEn ? 'Projects' : 'Proyectos'}</a>
        <a href={routes.news} class:list={["nav-link", { active: isActive(routes.news) }]} aria-current={isActive(routes.news) ? 'page' : undefined}>{isEn ? 'News' : 'Noticias'}</a>
        <a href={routes.about} class:list={["nav-link", { active: isActive(routes.about) }]} aria-current={isActive(routes.about) ? 'page' : undefined}>{isEn ? 'About Us' : 'Nosotros'}</a>
        <a href={routes.gallery} class:list={["nav-link", { active: isActive(routes.gallery) }]} aria-current={isActive(routes.gallery) ? 'page' : undefined}>{isEn ? 'Gallery' : 'Galería'}</a>
        <a href={routes.contact} class:list={["nav-link", { active: isActive(routes.contact) }]} aria-current={isActive(routes.contact) ? 'page' : undefined}>{isEn ? 'Contact' : 'Contacto'}</a>
