---
export interface Props {
  title: string;
}

const { title } = Astro.props;
const currentPath = Astro.url.pathname;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content="Corporación Matías Restrepo - Excelencia con sentido humano. Apoyamos a personas con discapacidad y cáncer en Guarne, Antioquia." />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/png" href="/logo.png" />
    
    <!-- Fuentes -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;600&family=Playfair+Display:ital,wght@0,600;1,600&display=swap" rel="stylesheet">
    
    <!-- Animaciones AOS (Animate on Scroll) -->
    <link href="https://unpkg.com/aos@2.3.1/dist/aos.css" rel="stylesheet">
    
    <title>{title} | Corporación Matías Restrepo</title>
    
    <style is:global>
      /* Blindaje contra desbordamiento horizontal */
      html, body {
        overflow-x: hidden;
        max-width: 100vw;
        margin: 0;
        padding: 0;
      }
      *, *::before, *::after {
        box-sizing: border-box;
      }

      /* Variables de diseño */
      :root {
        --color-primario: #c1121f;
        --color-secundario: #2a9d8f;
        --color-texto: #2b2b2b;
        --color-fondo: #ffffff;
        --fuente-titulos: 'Playfair Display', serif;
        --fuente-cuerpo: 'Inter', sans-serif;
      }

      body {
        font-family: var(--fuente-cuerpo);
        color: var(--color-texto);
        background-color: var(--color-fondo);
        line-height: 1.6;
        -webkit-font-smoothing: antialiased;
      }

      h1, h2, h3 { font-family: var(--fuente-titulos); font-weight: 600; color: #1a1a1a; }
      a { text-decoration: none; color: inherit; }
      
      /* Estilos del menú de navegación */
      .nav-link { padding: 0.5rem 1rem; border-radius: 5px; transition: all 0.3s ease; font-size: 0.95rem; }
      .nav-link:hover { color: var(--color-primario); background-color: #f0f0f0; }
      .nav-link.active { font-weight: 600; color: var(--color-primario); border-bottom: 2px solid var(--color-primario); border-radius: 0; }

      /* --- EFECTO STICKY HEADER SHRINK --- */
      .main-header {
        position: sticky;
        top: 0;
        z-index: 100;
        display: flex;
        flex-wrap: wrap;
        justify-content: space-between;
        align-items: center;
        background: rgba(255, 255, 255, 0.95);
        backdrop-filter: blur(10px);
        transition: padding 0.4s ease, background 0.4s ease, box-shadow 0.4s ease, border-bottom 0.4s ease;
        padding: 1.5rem 5%; /* Tamaño normal */
        border-bottom: 1px solid transparent;
      }

      /* Cuando se hace scroll, se encoge */
      .main-header.scrolled {
        padding: 0.5rem 5% !important;
        background: rgba(255, 255, 255, 0.98);
        border-bottom: 1px solid #eaeaea;
        box-shadow: 0 4px 15px rgba(0, 0, 0, 0.05);
      }

      .main-header .logo-img {
        width: 70px;
        transition: width 0.4s ease;
      }
      .main-header.scrolled .logo-img {
        width: 45px !important;
      }

      .main-header .logo-text {
        font-family: var(--fuente-titulos);
        font-size: 1.5rem;
        font-weight: 600;
        color: #1a1a1a;
        transition: font-size 0.4s ease;
      }
      .main-header.scrolled .logo-text {
        font-size: 1.2rem !important;
      }

      /* Ajuste del botón de Ko-fi en móviles */
      @media (max-width: 768px) {
        .floatingchat-container-wrap, 
        .floatingchat-container-wrap-mobi {
          transform: scale(0.85);
          transform-origin: bottom left;
        }
      }

      /* Estilos para el Alto Contraste de Accesibilidad */
      body.high-contrast { background-color: #000 !important; color: #fff !important; }
      body.high-contrast main, body.high-contrast footer, body.high-contrast header, body.high-contrast section, body.high-contrast div, body.high-contrast h1, body.high-contrast h2, body.high-contrast h3, body.high-contrast p, body.high-contrast a, body.high-contrast span, body.high-contrast li {
        background-color: #000 !important;
        color: #ffeb3b !important;
      }
      body.high-contrast img { filter: grayscale(100%) contrast(120%); }
      body.high-contrast button, body.high-contrast a[style*="background"] {
        background-color: #ffeb3b !important;
        color: #000 !important;
        border: 2px solid #fff !important;
      }
    </style>
  </head>
  
  <body>
    <!-- Header con la clase main-header -->
    <header class="main-header">
      <a href="/" style="display: flex; align-items: center; gap: 10px; text-decoration: none;">
        <img src="/logo.png" alt="Logo" class="logo-img" />
        <span class="logo-text">
          Corporación <span style="color: var(--color-primario);">Matías Restrepo</span>
        </span>
      </a>
      
      <nav style="display: flex; gap: 0.5rem; align-items: center; flex-wrap: wrap; margin-top: 10px;">
        <a href="/" class={`nav-link ${currentPath === '/' ? 'active' : ''}`}>Inicio</a>
        <a href="/proyectos" class={`nav-link ${currentPath === '/proyectos' ? 'active' : ''}`}>Proyectos</a>
        <a href="/noticias" class={`nav-link ${currentPath === '/noticias' ? 'active' : ''}`}>Noticias</a>
        <a href="/nosotros" class={`nav-link ${currentPath === '/nosotros' ? 'active' : ''}`}>Nosotros</a>
        <a href="/galeria" class={`nav-link ${currentPath === '/galeria' ? 'active' : ''}`}>Galería</a>
        <a href="/contacto" class={`nav-link ${currentPath === '/contacto' ? 'active' : ''}`}>Contacto</a>
        <a href="/voluntariado" class={`nav-link ${currentPath === '/voluntariado' ? 'active' : ''}`}>Voluntariado</a>
        <a href="/donar" style="background: var(--color-primario); color: white; padding: 0.6rem 1.5rem; border-radius: 50px; font-weight: 600; margin-left: 1rem; transition: transform 0.2s;">Donar</a>
      </nav>
    </header>

    <main>
      <slot />
    </main>

    <!-- Footer Elegante -->
    <footer style="background-color: #1a1a1a; color: #ffffff; padding: 4rem 5% 2rem; margin-top: 5rem;">
      <div style="display: flex; flex-direction: column; align-items: center; text-align: center; gap: 1.5rem;">
        
        <img src="/logo.png" alt="Logo" style="width: 120px; border-radius: 50%; background: white; padding: 10px;" />
        <h3 style="color: white; margin: 0; font-family: var(--fuente-titulos);">Excelencia con sentido humano</h3>
        <p style="color: #a0a0a0; font-size: 0.9rem; max-width: 400px;">Trabajando por la comunidad del Oriente Antioqueño, Guarne y sus alrededores.</p>
        
        <!-- Redes Sociales -->
        <div style="display: flex; gap: 1.5rem; margin-top: 1rem;">
          <a href="https://www.facebook.com/share/1BwGbxMgt8/" target="_blank" rel="noopener noreferrer" aria-label="Facebook" style="color: #a0a0a0; transition: color 0.3s;" onmouseover="this.style.color='#1877F2'" onmouseout="this.style.color='#a0a0a0'">
            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="currentColor"><path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.469h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.469h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/></svg>
          </a>
          
          <a href="https://www.instagram.com/corpmr_/" target="_blank" rel="noopener noreferrer" aria-label="Instagram" style="color: #a0a0a0; transition: color 0.3s;" onmouseover="this.style.color='#E1306C'" onmouseout="this.style.color='#a0a0a0'">
            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zM12 0C8.741 0 8.333.014 7.053.072 2.695.272.273 2.69.073 7.052.014 8.333 0 8.741 0 12c0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98C8.333 23.986 8.741 24 12 24c3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98C15.668.014 15.259 0 12 0zm0 5.838a6.162 6.162 0 100 12.324 6.162 6.162 0 000-12.324zM12 16a4 4 0 110-8 4 4 0 010 8zm6.406-11.845a1.44 1.44 0 100 2.881 1.44 1.44 0 000-2.881z"/></svg>
          </a>
          
          <a href="https://youtube.com/@corporacionmatiasrestrepo" target="_blank" rel="noopener noreferrer" aria-label="YouTube" style="color: #a0a0a0; transition: color 0.3s;" onmouseover="this.style.color='#FF0000'" onmouseout="this.style.color='#a0a0a0'">
            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="currentColor"><path d="M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 0 0 .502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z"/></svg>
          </a>
        </div>

        <!-- Correo Electrónico -->
        <a href="https://mail.google.com/mail/?view=cm&fs=1&to=corporacionmatiasrestrepo@gmail.com" target="_blank" rel="noopener noreferrer" style="color: #a0a0a0; font-size: 0.9rem; text-decoration: none; margin-top: 0.5rem; transition: color 0.3s;" onmouseover="this.style.color='#fff'" onmouseout="this.style.color='#a0a0a0'">
          corporacionmatiasrestrepo@gmail.com
        </a>

        <!-- Enlaces Legales -->
        <div style="display: flex; gap: 1.5rem; font-size: 0.85rem; margin-top: 1rem; flex-wrap: wrap; justify-content: center;">
          <a href="/transparencia" style="color: #a0a0a0; transition: color 0.3s;" onmouseover="this.style.color='#fff'" onmouseout="this.style.color='#a0a0a0'">Transparencia</a>
          <a href="/privacidad" style="color: #a0a0a0; transition: color 0.3s;" onmouseover="this.style.color='#fff'" onmouseout="this.style.color='#a0a0a0'">Política de Privacidad</a>
        </div>

        <!-- Copyright y Antigüedad -->
        <div style="margin-top: 2rem; border-top: 1px solid #333; padding-top: 2rem; width: 100%; font-size: 0.8rem; color: #666; display: flex; flex-direction: column; gap: 0.5rem;">
          <p style="margin: 0;">&copy; 2025 - {new Date().getFullYear()} Corporación Matías Restrepo. Todos los derechos reservados.</p>
          <p style="margin: 0; font-size: 0.75rem; color: #555;">Fundación sin ánimo de lucro constituida en Guarne, Antioquia desde 2025.</p>
        </div>
      </div>
    </footer>

    <!-- Botón de Accesibilidad -->
    <button id="accessibility-btn" aria-label="Opciones de accesibilidad" style="position: fixed; bottom: 20px; right: 20px; z-index: 99999; background: #1a1a1a; color: white; border: none; border-radius: 50%; width: 50px; height: 50px; font-size: 24px; cursor: pointer; box-shadow: 0 4px 10px rgba(0,0,0,0.3); display: flex; justify-content: center; align-items: center; transition: transform 0.2s;">
      ♿
    </button>

    <!-- Panel de Accesibilidad -->
    <div id="accessibility-panel" style="display: none; position: fixed; bottom: 80px; right: 20px; z-index: 99999; background: white; border: 1px solid #eaeaea; border-radius: 15px; padding: 1.5rem; box-shadow: 0 10px 30px rgba(0,0,0,0.15); width: 250px;">
      <h3 style="margin-top: 0; font-size: 1.1rem; margin-bottom: 1rem; color: #1a1a1a;">Opciones de Accesibilidad</h3>
      
      <div style="display: flex; flex-direction: column; gap: 0.8rem;">
        <button onclick="changeFontSize(1)" style="padding: 0.8rem; background: #f8f9fa; border: 1px solid #ccc; border-radius: 8px; cursor: pointer; font-weight: 600; text-align: left;">A+ Aumentar texto</button>
        <button onclick="changeFontSize(-1)" style="padding: 0.8rem; background: #f8f9fa; border: 1px solid #ccc; border-radius: 8px; cursor: pointer; font-weight: 600; text-align: left;">A- Disminuir texto</button>
        <button onclick="toggleContrast()" style="padding: 0.8rem; background: #f8f9fa; border: 1px solid #ccc; border-radius: 8px; cursor: pointer; font-weight: 600; text-align: left;">🌗 Alto contraste</button>
        <button onclick="resetAccessibility()" style="padding: 0.8rem; background: #e0e0e0; border: none; border-radius: 8px; cursor: pointer; font-weight: 600; text-align: left; margin-top: 0.5rem;">Restablecer</button>
      </div>
    </div>

    <!-- UN SOLO BLOQUE DE SCRIPT PARA ACCESIBILIDAD Y STICKY HEADER -->
    <script is:inline>
      // --- 1. LÓGICA DE ACCESIBILIDAD ---
      const accBtn = document.getElementById('accessibility-btn');
      const accPanel = document.getElementById('accessibility-panel');
      let currentFontSize = 100;

      if (accBtn) {
        accBtn.addEventListener('click', () => {
          accPanel.style.display = accPanel.style.display === 'none' ? 'block' : 'none';
        });
      }

      window.changeFontSize = function(direction) {
        currentFontSize += direction * 10;
        if (currentFontSize < 80) currentFontSize = 80;
        if (currentFontSize > 150) currentFontSize = 150;
        document.documentElement.style.fontSize = `${currentFontSize}%`;
      };

      window.toggleContrast = function() {
        document.body.classList.toggle('high-contrast');
      };

      window.resetAccessibility = function() {
        currentFontSize = 100;
        document.documentElement.style.fontSize = '100%';
        document.body.classList.remove('high-contrast');
      };

      // --- 2. LÓGICA DEL STICKY HEADER ---
      function initStickyHeader() {
        const header = document.querySelector('.main-header');
        if (!header) return;

        window.removeEventListener('scroll', handleHeaderScroll);

        function handleHeaderScroll() {
          if (window.scrollY > 50) {
            header.classList.add('scrolled');
          } else {
            header.classList.remove('scrolled');
          }
        }

        window.addEventListener('scroll', handleHeaderScroll);
        handleHeaderScroll(); 
      }

      document.addEventListener('astro:page-load', initStickyHeader);
      document.addEventListener('DOMContentLoaded', initStickyHeader);
    </script> 
    
    <!-- Ko-fi -->
    <script src='https://storage.ko-fi.com/cdn/scripts/overlay-widget.js' is:inline></script>
    <script is:inline>
      kofiWidgetOverlay.draw('corporacionmatiasrestrepo', {
        'type': 'floating-chat',
        'floating-chat.donateButton.text': 'Apóyanos',
        'floating-chat.donateButton.background-color': '#c1121f',
        'floating-chat.donateButton.text-color': '#fff',
        'floating-chat.donateButton.position': 'right'
      });
    </script>

    <!-- Script de Animaciones AOS -->
    <script src="https://unpkg.com/aos@2.3.1/dist/aos.js" is:inline></script>
    <script is:inline>
      AOS.init({
        duration: 800,
        once: true,
        offset: 100,
      });
    </script>
  </body>
</html>