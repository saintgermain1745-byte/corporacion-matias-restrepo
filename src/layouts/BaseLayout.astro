---
export interface Props {
  title: string;
}

const { title } = Astro.props;
const currentPath = Astro.url.pathname;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content="Corporación Matías Restrepo - Excelencia con sentido humano. Apoyamos a personas con discapacidad y cáncer en Guarne, Antioquia." />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/png" href="/logo.png" />
    
    <!-- Fuentes -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;600&family=Playfair+Display:ital,wght@0,600;1,600&display=swap" rel="stylesheet">
    
    <!-- Animaciones AOS -->
    <link href="https://unpkg.com/aos@2.3.1/dist/aos.css" rel="stylesheet">
    
    <title>{title} | Corporación Matías Restrepo</title>
    
    <style is:global>
      /* Blindaje contra desbordamiento horizontal */
      html, body {
        overflow-x: hidden;
        max-width: 100vw;
        margin: 0;
        padding: 0;
      }
      *, *::before, *::after {
        box-sizing: border-box;
      }

      /* Variables de diseño */
      :root {
        --color-primario: #c1121f;
        --color-secundario: #2a9d8f;
        --color-texto: #2b2b2b;
        --color-fondo: #ffffff;
        --fuente-titulos: 'Playfair Display', serif;
        --fuente-cuerpo: 'Inter', sans-serif;
      }

      body {
        font-family: var(--fuente-cuerpo);
        color: var(--color-texto);
        background-color: var(--color-fondo);
        line-height: 1.6;
        -webkit-font-smoothing: antialiased;
      }

      h1, h2, h3 { font-family: var(--fuente-titulos); font-weight: 600; color: #1a1a1a; }
      a { text-decoration: none; color: inherit; }
      
      /* --- HEADER Y NAVEGACIÓN --- */
      .main-header {
        position: sticky;
        top: 0;
        z-index: 100;
        display: flex;
        justify-content: space-between; /* Logo a la izquierda, menú a la derecha */
        align-items: center;
        background: rgba(255, 255, 255, 0.95);
        backdrop-filter: blur(10px);
        transition: padding 0.4s ease, background 0.4s ease, box-shadow 0.4s ease;
        padding: 1.5rem 5%;
        border-bottom: 1px solid transparent;
      }

      .main-header.scrolled {
        padding: 0.5rem 5% !important;
        background: rgba(255, 255, 255, 0.98);
        border-bottom: 1px solid #eaeaea;
        box-shadow: 0 4px 15px rgba(0, 0, 0, 0.05);
      }

      .header-top {
        display: flex;
        align-items: center;
        margin-right: 2rem; /* Espacio entre el logo y el menù */ 
      }

      /* AQUÍ ESTÁ EL TRUCO PARA QUE EL LOGO NO SEA GIGANTE */
      .main-header .logo-img { 
        width: 70px !important; 
        height: auto;
        transition: width 0.4s ease; 
      }
      .main-header.scrolled .logo-img { width: 45px !important; }

        .main-header .logo-text {
        font-family: var(--fuente-titulos);
        font-size: 1.5rem;
        font-weight: 600;
        color: #1a1a1a;
        /* transition: font-size 0.4s ease;  <-- También puedes borrar esta línea, ya no es necesaria */
        margin-left: 10px;
        white-space: nowrap; /* Esto sí déjalo, es el que evita que se rompa en dos líneas */
      }

      /* .main-header.scrolled .logo-text { font-size: 1.2rem !important; } <-- ELIMINA O COMENTA ESTA LÍNEA */
      .main-header.scrolled .logo-text { font-size: 1.2rem !important; }

          /* Menú de escritorio */
      .desktop-nav {
        display: flex;
        gap: 0.5rem;
        align-items: center;
        margin-left: auto; /* Empuja el menú hacia la derecha */
        margin-right: auto; /* Lo centra un poco si sobra espacio */
      }

      .nav-link { 
        display: flex; 
        align-items: center; 
        gap: 6px; 
        padding: 0.5rem 1rem; 
        border-radius: 5px; 
        transition: all 0.3s ease; 
        font-size: 0.95rem; 
      }
      .nav-link:hover { color: var(--color-primario); background-color: #f0f0f0; }
      .nav-link.active { font-weight: 600; color: var(--color-primario); border-bottom: 2px solid var(--color-primario); border-radius: 0; }

      .btn-donar {
        display: flex;
        align-items: center;
        gap: 6px;
        background: var(--color-primario);
        color: white;
        padding: 0.6rem 1.5rem;
        border-radius: 50px;
        font-weight: 600;
        margin-left: 1rem; 
        transition: transform 0.2s;
      }

      /* Botón Hamburguesa (Oculto en PC) */
      .hamburger {
        display: none;
        background: none;
        border: none;
        cursor: pointer;
        flex-direction: column;
        gap: 6px;
      }
      .hamburger span {
        display: block;
        width: 30px;
        height: 3px;
        background: #1a1a1a;
        transition: 0.3s;
      }

      /* Menú Móvil */
      .mobile-nav {
        display: none;
        flex-direction: column;
        width: 100%;
        background: white;
        border-top: 1px solid #eaeaea;
      }
      .mobile-nav.active { display: flex; }
      .mobile-nav .nav-link {
        padding: 1rem;
        border-bottom: 1px solid #f0f0f0;
        border-radius: 0;
      }

      /* --- RESPONSIVE MÓVIL --- */
      @media (max-width: 900px) {
        .main-header { 
          flex-direction: column; /* Apila el logo y el menú */
          align-items: flex-start;
          padding: 1rem 5%;
        }
        .header-top {
          width: 100%; /* Ocupa todo el ancho para empujar la hamburguesa a la derecha */
          justify-content: space-between;
        }
        .desktop-nav { display: none; } 
        .hamburger { display: flex; } 
        
        .main-header .logo-text { font-size: 1.1rem; }
        .main-header .logo-img { width: 50px !important; }
        
        .floatingchat-container-wrap, .floatingchat-container-wrap-mobi {
          transform: scale(0.85);
          transform-origin: bottom left;
        }
      }

      /* Estilos para el Alto Contraste */
      body.high-contrast { background-color: #000 !important; color: #fff !important; }
      body.high-contrast main, body.high-contrast footer, body.high-contrast header, body.high-contrast section, body.high-contrast div, body.high-contrast h1, body.high-contrast h2, body.high-contrast h3, body.high-contrast p, body.high-contrast a, body.high-contrast span, body.high-contrast li {
        background-color: #000 !important;
        color: #ffeb3b !important;
      }
      body.high-contrast img { filter: grayscale(100%) contrast(120%); }
      body.high-contrast button, body.high-contrast a[style*="background"] {
        background-color: #ffeb3b !important;
        color: #000 !important;
        border: 2px solid #fff !important;
      }
            /* ... estilos anteriores ... */

      /* Estilo para el título del panel de accesibilidad */
      #accessibility-panel h3 {
        font-family: var(--fuente-cuerpo) !important; 
        font-size: 1rem !important; 
        font-weight: 600 !important;
        margin-bottom: 1rem !important;
        color: #1a1a1a !important;
      }
    </style>
  </head>
  
  <body>
    <header class="main-header">
      <!-- Contenedor del Logo y Hamburguesa -->
      <div class="header-top">
        <a href="/" style="display: flex; align-items: center; text-decoration: none;">
          <img src="/logo.png" alt="Logo" class="logo-img" />
          <span class="logo-text">
            Corporación <span style="color: var(--color-primario);">Matías Restrepo</span>
          </span>
        </a>

        <button class="hamburger" id="mobile-menu-btn" aria-label="Abrir menú">
          <span></span>
          <span></span>
          <span></span>
        </button>
      </div>
      
      <!-- Menú de PC -->
      <nav class="desktop-nav">
        <a href="/" class={`nav-link ${currentPath === '/' ? 'active' : ''}`}>
