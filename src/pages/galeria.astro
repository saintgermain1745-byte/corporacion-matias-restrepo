---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Galería">
  <section style="padding: 4rem 5%; max-width: 1200px; margin: 0 auto;">
    
    <div style="text-align: center; margin-bottom: 4rem;" data-aos="fade-up">
      <h1 style="font-size: 3rem;">Nuestra Labor en Imágenes</h1>
      <p style="color: #666; font-size: 1.1rem;">Momentos de esperanza, comunidad y apoyo en Guarne, Antioquia.</p>
    </div>

    <!-- Cuadrícula de Imágenes -->
    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: 1.5rem;">
      
      <!-- Aquí irán las imágenes reales. De momento dejamos ejemplos -->
      <div data-aos="fade-up" style="border-radius: 15px; overflow: hidden; box-shadow: 0 10px 20px rgba(0,0,0,0.1); cursor: pointer; transition: transform 0.3s ease;">
        <img src="https://images.unsplash.com/photo-1576091160399-112ba8d25d1d?q=80&w=600&auto=format&fit=crop" alt="Apoyo médico" style="width: 100%; height: 250px; object-fit: cover; transition: transform 0.5s ease;" />
      </div>
      
      <div data-aos="fade-up" data-aos-delay="100" style="border-radius: 15px; overflow: hidden; box-shadow: 0 10px 20px rgba(0,0,0,0.1); cursor: pointer; transition: transform 0.3s ease;">
        <img src="https://images.unsplash.com/photo-1518398046578-8cca57782e17?q=80&w=600&auto=format&fit=crop" alt="Comunidad" style="width: 100%; height: 250px; object-fit: cover; transition: transform 0.5s ease;" />
      </div>

      <div data-aos="fade-up" data-aos-delay="200" style="border-radius: 15px; overflow: hidden; box-shadow: 0 10px 20px rgba(0,0,0,0.1); cursor: pointer; transition: transform 0.3s ease;">
        <img src="https://images.unsplash.com/photo-1584515933487-779824d29309?q=80&w=600&auto=format&fit=crop" alt="Voluntariado" style="width: 100%; height: 250px; object-fit: cover; transition: transform 0.5s ease;" />
      </div>

    </div>

    <!-- Sección de Video (Ejemplo) -->
    <div style="margin-top: 5rem;" data-aos="fade-up">
      <h2 style="text-align: center; margin-bottom: 2rem;">Nuestro Impacto en Video</h2>
      <div style="border-radius: 15px; overflow: hidden; box-shadow: 0 15px 30px rgba(0,0,0,0.15); aspect-ratio: 16 / 9;">
        <!-- Aquí puedes pegar el iframe de un video de YouTube de la fundación -->
        <iframe width="100%" height="100%" src="https://www.youtube.com/embed/dQw4w9WgXcQ" title="YouTube video player" frameborder="0" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture" allowfullscreen></iframe>
      </div>
    </div>

  </section>
</BaseLayout>