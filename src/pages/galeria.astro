---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Galería">
  <section style="padding: 4rem 5%; max-width: 1200px; margin: 0 auto;">
    
    <div style="text-align: center; margin-bottom: 4rem;" data-aos="fade-up">
      <h1 style="font-size: 3rem;">Nuestra Labor en Imágenes</h1>
      <p style="color: #666; font-size: 1.1rem;">Momentos de esperanza, comunidad y apoyo en Guarne, Antioquia.</p>
    </div>

    <!-- Cuadrícula de Imágenes -->
    <div style="display: grid; grid-template-columns: repeat(auto-fill, minmax(280px, 1fr)); gap: 1.5rem;">
      
      <!-- Imagen 1 -->
      <div class="gallery-item" data-aos="fade-up" data-aos-delay="50" onclick="openLightbox('/1.jpg')" style="border-radius: 15px; overflow: hidden; box-shadow: 0 10px 20px rgba(0,0,0,0.1); cursor: pointer; aspect-ratio: 4/3;">
        <img src="/1.jpg" alt="Labor de la fundación 1" loading="lazy" style="width: 100%; height: 100%; object-fit: cover; transition: transform 0.4s ease;" class="gallery-img" />
      </div>
      
