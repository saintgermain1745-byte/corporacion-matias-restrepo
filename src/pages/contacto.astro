---
import BaseLayout from '../layouts/BaseLayout.astro';
import { officialOfficeAddress, officialWhatsAppNumber } from '../data/contact';

const whatsappMessage = 'Hola, escribo desde la página web de la Corporación Matías Restrepo para coordinar mi donación o la entrega de un regalo en Guarne.';
const whatsappUrl = `https://wa.me/${officialWhatsAppNumber}?text=${encodeURIComponent(whatsappMessage)}`;
---

<BaseLayout title="Contacto">
  <section style="padding: 4rem 5%; max-width: 800px; margin: 0 auto;">
    
    <div style="text-align: center; margin-bottom: 3rem;" data-aos="fade-up">
      <h1 style="font-size: 3rem;">Hablemos</h1>
      <p style="color: #666; font-size: 1.1rem;">¿Tienes dudas, quieres ser voluntario o necesitas apoyo? Escríbenos.</p>
    </div>

    <aside data-aos="fade-up" style="margin-bottom: 2rem; padding: 1.5rem 1.75rem; border: 1px solid #e8eee8; border-radius: 15px; background: #f8fbf8;">
      <h2 style="margin: 0 0 0.5rem; font-size: 1.2rem;">Punto de recepción en Guarne</h2>
      <address style="color: #555; font-style: normal; line-height: 1.6;">{officialOfficeAddress.es}</address>
      <a href={whatsappUrl} target="_blank" rel="noopener noreferrer" style="display: inline-block; margin-top: 0.9rem; color: #15803d; font-weight: 700;">Escríbenos por WhatsApp</a>
    </aside>

    <form class="contact-form" action="https://api.web3forms.com/submit" method="POST" data-aos="fade-up" style="display: flex; flex-direction: column; gap: 1.5rem; background: #f8f9fa; padding: 3rem; border-radius: 15px; box-shadow: 0 10px 30px rgba(0,0,0,0.05);">
      
      <!-- Clave de Web3Forms integrada -->
      <input type="hidden" name="access_key" value="7820c9c0-0ff2-4b3d-a685-d50f47d772df">
      
      <div style="display: flex; flex-direction: column; gap: 0.5rem;">
        <label for="name" style="font-weight: 600;">Nombre completo</label>
        <input type="text" name="name" id="name" required style="padding: 1rem; border: 1px solid #ccc; border-radius: 8px; font-family: inherit;" />
      </div>

      <div style="display: flex; flex-direction: column; gap: 0.5rem;">
        <label for="email" style="font-weight: 600;">Correo electrónico</label>
        <input type="email" name="email" id="email" required style="padding: 1rem; border: 1px solid #ccc; border-radius: 8px; font-family: inherit;" />
      </div>

      <div style="display: flex; flex-direction: column; gap: 0.5rem;">
        <label for="message" style="font-weight: 600;">Mensaje</label>
        <textarea name="message" id="message" required rows="5" style="padding: 1rem; border: 1px solid #ccc; border-radius: 8px; font-family: inherit; resize: vertical;"></textarea>
      </div>

      <button type="submit" style="background: var(--color-primario); color: white; padding: 1rem 2rem; border: none; border-radius: 50px; font-weight: 600; font-size: 1.1rem; cursor: pointer; transition: background 0.3s; margin-top: 1rem;">
        Enviar Mensaje
      </button>
    </form>
  </section>
  <style is:global>
    .contact-form { width: 100%; min-width: 0; }
    .contact-form input, .contact-form textarea { width: 100%; min-width: 0; max-width: 100%; }
    @media (max-width: 600px) {
      .contact-form { padding: 1.25rem !important; }
    }
  </style>
</BaseLayout>