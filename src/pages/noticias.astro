---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Noticias de Salud">
  <section style="padding: 5rem 5% 3rem; text-align: center; background: linear-gradient(180deg, #ffffff 0%, #f8f9fa 100%);" data-aos="fade-up">
    <div style="max-width: 800px; margin: 0 auto;">
      <h1 style="font-size: 3.5rem; margin-bottom: 1rem;">Noticias y Avances</h1>
      <p style="font-size: 1.2rem; color: #555;">
        Mantente al día con los últimos avances médicos, tecnológicos y sociales relacionados con la discapacidad y el cáncer.
      </p>
    </div>
  </section>

  <section style="padding: 3rem 5% 5rem; max-width: 1200px; margin: 0 auto;">
    <div id="news-container" style="display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 320px), 1fr)); gap: 2.5rem;">
      <p style="text-align: center; width: 100%; color: #888; font-size: 1.2rem;">⏳ Cargando las últimas noticias de salud...</p>
    </div>
  </section>

  <script is:inline>
    async function cargarNoticias() {
      const container = document.getElementById('news-container');
      
      try {
        const response = await fetch('/api/noticias');
        
        if (!response.ok) {
          throw new Error('Error en la petición al servidor');
        }

        const noticias = await response.json();

        if (!Array.isArray(noticias) || noticias.length === 0) {
          container.innerHTML = '<p style="text-align: center; width: 100%;">No hay noticias nuevas en este momento.</p>';
          return;
        }

        container.innerHTML = ''; 

        noticias.forEach((noticia, index) => {
          const fecha = new Date(noticia.fecha).toLocaleDateString('es-CO', {
            year: 'numeric', month: 'long', day: 'numeric'
          });

          const imagenUrl = noticia.imagen || 'https://images.unsplash.com/photo-1576091160399-112ba8d25d1d?q=80&w=600&auto=format&fit=crop';

          const article = document.createElement('article');
          article.setAttribute('data-aos', 'fade-up');
          article.setAttribute('data-aos-delay', index * 100);
          article.style.cssText = "background: white; border-radius: 15px; overflow: hidden; box-shadow: 0 10px 30px rgba(0,0,0,0.08); display: flex; flex-direction: column;";

          article.innerHTML = `
            <div style="height: 200px; overflow: hidden;">
              <img src="${imagenUrl}" alt="${noticia.titulo}" style="width: 100%; height: 100%; object-fit: cover; transition: transform 0.3s ease;" class="news-img" />
            </div>
            <div style="padding: 1.5rem; flex-grow: 1; display: flex; flex-direction: column;">
              <span style="color: var(--color-secundario); font-size: 0.85rem; font-weight: 600; text-transform: uppercase; letter-spacing: 1px;">${fecha} | ${noticia.fuente}</span>
              <h3 style="font-size: 1.3rem; margin: 0.5rem 0 1rem; color: #1a1a1a; line-height: 1.3;">${noticia.titulo}</h3>
              <p style="color: #666; font-size: 0.95rem; flex-grow: 1; margin-bottom: 1.5rem;">${noticia.descripcion || 'Haz clic para leer la noticia completa.'}</p>
              
              <a href="${noticia.url}" target="_blank" rel="noopener noreferrer" style="color: var(--color-primario); font-weight: 600; text-decoration: none; display: inline-block;">
                Leer más en ${noticia.fuente} &rarr;
              </a>
            </div>
          `;
          container.appendChild(article);
        });

        if (window.AOS) {
          window.AOS.refresh();
        }

      } catch (error) {
        console.error(error);
        container.innerHTML = '<p style="text-align: center; width: 100%; color: red;">Error al cargar las noticias. Por favor, recarga la página.</p>';
      }
    }

    document.addEventListener('astro:page-load', cargarNoticias);
    document.addEventListener('DOMContentLoaded', cargarNoticias);
  </script>
</BaseLayout>