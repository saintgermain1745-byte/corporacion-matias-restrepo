---
import BaseLayout from '../../layouts/BaseLayout.astro';

const events = [
  { name: "Christmas", cover: "/1.jpg", photos: ["/1.jpg", "/2.jpg", "/3.jpg", "/4.jpg", "/5.jpg", "/6.jpg"] },
  { name: "Groceries", cover: "/9.jpg", photos: ["/7.jpg", "/8.jpg", "/9.jpg", "/10.jpg", "/11.jpg"] },
  { name: "Community", cover: "/14.jpg", photos: ["/12.jpg", "/13.jpg", "/14.jpg", "/15.jpg"] }
];

const photos = [
  { src: "/1.jpg", alt: "Volunteers at a community Christmas event" },
  { src: "/2.jpg", alt: "Delivery of gifts and support to families in Guarne" },
  { src: "/3.jpg", alt: "Children and families during a community activity" },
  { src: "/4.jpg", alt: "Community celebration with beneficiaries" },
  { src: "/5.jpg", alt: "Foundation member at a special community event" },
  { src: "/6.jpg", alt: "Support for people with disabilities in Guarne" },
  { src: "/7.jpg", alt: "Volunteers and beneficiaries together" },
  { src: "/8.jpg", alt: "Community integration event in Eastern Antioquia" },
  { src: "/9.jpg", alt: "Delivery of a family grocery basket" },
  { src: "/10.jpg", alt: "Community health and support workshop" },
  { src: "/11.jpg", alt: "Supplies ready for delivery" },
  { src: "/12.jpg", alt: "Preparing groceries for vulnerable families" },
  { src: "/13.jpg", alt: "Accompaniment for a cancer patient" },
  { src: "/14.jpg", alt: "Health and physical activity walk" },
  { src: "/15.jpg", alt: "Humanitarian assistance in a rural area" }
];
---

<BaseLayout title="Gallery">
  <section style="padding: 4rem 5%; max-width: 1200px; margin: 0 auto;">
    <div style="text-align: center; margin-bottom: 3rem;" data-aos="fade-up">
      <h1 style="font-size: 3rem;">Our Work in Pictures</h1>
      <p style="color: #666; font-size: 1.1rem;">Moments of hope, community and support in Guarne, Antioquia.</p>
    </div>

    <div style="display: flex; gap: 1.5rem; overflow-x: auto; padding-bottom: 1.5rem; margin-bottom: 3rem; justify-content: center; flex-wrap: wrap;" data-aos="fade-up">
      {events.map((event) => (
        <div style="text-align: center;">
          <div style="width: 90px; height: 90px; border-radius: 50%; padding: 3px; background: linear-gradient(45deg, #f09433, #e6683c, #dc2743, #cc2366, #bc1888);">
            <img src={event.cover} alt={`${event.name} event`} style="width: 100%; height: 100%; border-radius: 50%; border: 3px solid white; object-fit: cover;" />
          </div>
          <p style="margin-top: 0.5rem; font-size: 0.9rem; font-weight: 600;">{event.name}</p>
        </div>
      ))}
    </div>

    <h2 style="text-align: center;">All Moments</h2>
    <div class="masonry-gallery" style="margin-top: 2rem;">
      {photos.map((photo) => (
        <div style="break-inside: avoid; margin-bottom: 1.5rem; border-radius: 12px; overflow: hidden; box-shadow: 0 5px 15px rgba(0,0,0,0.08);">
          <img src={photo.src} alt={photo.alt} loading="lazy" style="width: 100%; display: block;" />
        </div>
      ))}
    </div>

    <div style="margin-top: 5rem;" data-aos="fade-up">
      <h2 style="text-align: center; margin-bottom: 3rem; font-size: 2.5rem;">Our Videos</h2>
      <div style="display: flex; flex-wrap: wrap; justify-content: center; gap: 2rem;">
        {["2B2xj6OnPYo", "mlahIPTVGMI", "qF7tzb3yn44", "YlL9OGE_hn4", "lpn6Xr9MAfs", "ZnzedLQhH7U"].map((video) => (
          <div style="border-radius: 15px; overflow: hidden; box-shadow: 0 10px 20px rgba(0,0,0,0.1); aspect-ratio: 9 / 16; width: 100%; max-width: 320px;">
            <iframe width="100%" height="100%" src={`https://www.youtube.com/embed/${video}`} title="Corporación Matías Restrepo video" allowfullscreen></iframe>
          </div>
        ))}
      </div>
    </div>
  </section>

  <style is:global>
    .masonry-gallery { column-count: 1; }
    @media (min-width: 600px) { .masonry-gallery { column-count: 2; } }
    @media (min-width: 900px) { .masonry-gallery { column-count: 3; } }
    @media (min-width: 1200px) { .masonry-gallery { column-count: 4; } }
  </style>
</BaseLayout>
