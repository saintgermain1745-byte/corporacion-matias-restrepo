---
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout title="Donate">
  <section style="padding: 5rem 5% 3rem; text-align: center; background: linear-gradient(180deg, #ffffff 0%, #f8f9fa 100%);" data-aos="fade-up">
    <div style="max-width: 800px; margin: 0 auto;">
      <h1 style="font-size: 3rem;">Your Help Has a Real Impact</h1>
      <p style="font-size: 1.2rem; color: #555;">Every contribution helps us continue supporting families in Guarne and Eastern Antioquia.</p>
    </div>
  </section>
  <section style="padding: 2rem 5% 5rem; max-width: 1200px; margin: 0 auto;">
    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(250px, 1fr)); gap: 2rem;">
      <article style="background: white; border-radius: 15px; padding: 2rem; text-align: center; box-shadow: 0 10px 30px rgba(0,0,0,0.08);">
        <span style="font-size: 3rem;">🛒</span><h3>Family Grocery Basket</h3><p style="color: #666;">Help a vulnerable family cover basic food needs.</p>
        <a href="https://ko-fi.com/corporacionmatiasrestrepo/?amount=10" target="_blank" rel="noopener noreferrer" style="display: block; background: var(--color-primario); color: white; padding: 1rem; border-radius: 8px; font-weight: 600;">Donate $10 USD</a>
      </article>
      <article style="background: white; border-radius: 15px; padding: 2rem; text-align: center; box-shadow: 0 10px 30px rgba(0,0,0,0.08);">
        <span style="font-size: 3rem;">🎗️</span><h3>Patient Support</h3><p style="color: #666;">Support transportation and basic supplies for cancer patients.</p>
        <a href="https://ko-fi.com/corporacionmatiasrestrepo/?amount=25" target="_blank" rel="noopener noreferrer" style="display: block; background: var(--color-secundario); color: white; padding: 1rem; border-radius: 8px; font-weight: 600;">Donate $25 USD</a>
      </article>
      <article style="background: white; border-radius: 15px; padding: 2rem; text-align: center; box-shadow: 0 10px 30px rgba(0,0,0,0.08);">
        <span style="font-size: 3rem;">🤝</span><h3>Community Support</h3><p style="color: #666;">Strengthen inclusion and community programs.</p>
        <a href="https://ko-fi.com/corporacionmatiasrestrepo/?amount=50" target="_blank" rel="noopener noreferrer" style="display: block; background: #4a6fa5; color: white; padding: 1rem; border-radius: 8px; font-weight: 600;">Donate $50 USD</a>
      </article>
    </div>
  </section>
</BaseLayout>
