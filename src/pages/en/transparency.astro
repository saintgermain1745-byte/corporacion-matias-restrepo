---
import BaseLayout from '../../layouts/BaseLayout.astro';
import fs from 'node:fs';
import path from 'node:path';

const isEn = true;
const documentosDir = path.join(process.cwd(), 'public', 'documentos');

let documentos: any[] = [];

try {
  if (fs.existsSync(documentosDir)) {
    documentos = fs
      .readdirSync(documentosDir, { withFileTypes: true })
      .filter((archivo) => archivo.isFile() && archivo.name.toLowerCase().endsWith('.pdf'))
      .map((archivo) => ({
        filename: archivo.name,
        title: archivo.name
          .replace(/\.pdf$/i, '')
          .replace(/^\d+(?:[.\-_]\s*|\s+)/, '')
          .replace(/[_-]+/g, ' ')
          .replace(/\s+/g, ' ')
          .trim()
          .toLocaleLowerCase('en')
          .replace(/\b\p{L}/gu, (letter) => letter.toLocaleUpperCase('en')),
      }))
      .sort((a, b) => a.filename.localeCompare(b.filename, 'en', { numeric: true }));
  }
} catch {
  documentos = [];
}
---

<BaseLayout title="Transparency">
  <section style="padding: 4rem 5%; max-width: 1000px; margin: 0 auto;" data-aos="fade-up">
    <div style="text-align: center; margin-bottom: 4rem;">
      <h1 style="font-size: 3rem;">Institutional Transparency</h1>
      <p style="color: #666; font-size: 1.1rem;">Trust is built through transparency. Here you can find our legal information.</p>
    </div>
    <div style="background: #f8f9fa; padding: 3rem; border-radius: 15px; border-left: 5px solid var(--color-primario);">
      <h2>Legal Information</h2>
      <ul style="list-style: none; padding: 0; line-height: 2;">
        <li><strong>Legal name:</strong> Corporación Matías Restrepo</li>
        <li><strong>NIT:</strong> 901967782-1</li>
        <li><strong>Address:</strong> CLL 48 NRO. 48A-25, Barrio San Francisco, Guarne, Antioquia</li>
        <li><strong>Phones:</strong> 300 786 8650 / 324 148 6271</li>
        <li><strong>Email:</strong> corporacionmatiasrestrepo@gmail.com</li>
        <li><strong>Type:</strong> Non-profit organization (ESAL)</li>
        <li><strong>Legal representative:</strong> Efrain Gallego Castro</li>
      </ul>
    </div>
    <section style="margin-top: 4rem;" aria-labelledby="documentos-rte">
      <div style="text-align: center; margin-bottom: 2rem;">
        <h2 id="documentos-rte" style="font-size: 1.8rem; margin-bottom: 0.8rem;">
          {isEn ? 'Corporation Documents' : 'Documentos de la Corporación'}
        </h2>
        <p style="color: #666; font-size: 1.05rem;">
          {isEn ? 'Consult and download our official documentation, statutes, and financial statements.' : 'Consulta y descarga nuestra documentación oficial, estatutos y estados financieros.'}
        </p>
      </div>

      {documentos.length > 0 ? (
        <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 1rem;">
          {documentos.map((documento) => (
            <a
              href={`/documentos/${encodeURIComponent(documento.filename)}`}
              target="_blank"
              rel="noopener noreferrer"
              style="background: white; border: 1px solid #e1e1e1; color: #333; padding: 1rem 1.25rem; border-radius: 10px; text-decoration: none; display: flex; align-items: center; justify-content: space-between; gap: 1rem; min-height: 52px; box-shadow: 0 2px 8px rgba(0, 0, 0, 0.04);"
            >
              <span style="font-weight: 600; line-height: 1.35;">{documento.title}</span>
              <svg aria-hidden="true" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="flex-shrink: 0;">
                <path d="M12 3v12"></path>
                <path d="m7 10 5 5 5-5"></path>
                <path d="M5 21h14"></path>
              </svg>
            </a>
          ))}
        </div>
      ) : (
        <p style="text-align: center; color: #999; background: #f8f9fa; border: 1px solid #eaeaea; border-radius: 10px; padding: 1.5rem;">
          {isEn ? 'Coming soon' : 'Próximamente'}
        </p>
      )}
    </section>
  </section>
</BaseLayout>
